# ==============================================================================
# High Fashion E-Commerce - Docker Environment Configuration Template
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Cache & Job Queue (Redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Medusa v2 Backend
# ------------------------------------------------------------------------------
BACKEND_PORT=9000
JWT_SECRET=generate_a_secure_jwt_secret_here_min_32_characters
COOKIE_SECRET=generate_a_secure_cookie_secret_here_min_32_characters
AUTH_MFA_ENCRYPTION_KEY=972e66bcad7a041defef7a2dc2013e1d6d86f5b120717dffaa8ac3a9de133a20

# CORS settings (Replace with your actual production domain or leave default for local testing)
STORE_CORS=http://localhost:8000,http://storefront:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Set to true only on first deployment to seed demo products and categories automatically
AUTO_SEED=false

# ------------------------------------------------------------------------------
# Next.js Storefront
# ------------------------------------------------------------------------------
STOREFRONT_PORT=8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_a1b1a57e199157b891153b25fe6a027815989c7a87fdd5cc874612e8d6723a0c
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SHOP_NAME="High Fashion"
NEXT_PUBLIC_SHOP_DESCRIPTION="High Fashion Store"

# Optional Keep-Alive Self-Ping (Useful for free tiers like Render to prevent sleeping)
# SELF_PING_URL=https://your-service.onrender.com
# PING_INTERVAL=600

# ------------------------------------------------------------------------------
# Optional Reverse Proxy (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

